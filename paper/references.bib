@inproceedings{sulaman_comparative_2022,
	title = {A comparative study of newly developed metaheuristics for the discrete uncapacitated {$p$}-median problem},
	volume = {1},
	issn = {2576-3555},
	url = {https://ieeexplore.ieee.org/document/9804107},
	doi = {10.1109/CoDIT55151.2022.9804107},
	abstract = {As one of the most prominent variants of the facility location problem, the p-median problem aims to determine the best locations for establishing p number of facilities such that the aggregate customers' transportation cost is minimized. Since the p-median problem is classified as NP-hard, the application of metaheuristics to solve it is inevitable. Considering the fast development in metaheuristics, choosing the most appropriate algorithm to solve this problem is a difficult task. Therefore, this work presents a comparative study of several classical and recently developed nature-inspired optimization algorithms to solve the discrete uncapacitated p-median problem on several randomly generated test instances with different sizes and spec-ifications.},
	urldate = {2024-09-26},
	booktitle = {2022 8th {International} {Conference} on {Control}, {Decision} and {Information} {Technologies} ({CoDIT})},
	author = {Sulaman, Muhammad and Golabi, Mahmoud and Brévilliers, Mathieu and Lepagnot, Julien and Idoumghar, Lhassane},
	month = may,
	year = {2022},
	keywords = {Aggregates, Classification algorithms, Costs, Metaheuristics, Nature Inspired Optimization Algorithms, Operations research, Space exploration, Transportation, facility location prob-lem, p-median},
	pages = {872--877},
}

